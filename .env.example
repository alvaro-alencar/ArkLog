# ArkLog secure deployment
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]

# Shared Ark account. This endpoint validates the bearer session token.
ARK_AUTH_ME_URL=https://www.arksystem.net/api/saas?action=me
ARK_AUTH_TIMEOUT_SECONDS=8
ARKLOG_AUTO_TRIAL=false
ARKLOG_TRIAL_REPORT_LIMIT=1
ARKLOG_ACTIVE_REPORT_LIMIT=50
ARKLOG_TRIAL_MAX_WINDOW_HOURS=168
ARKLOG_TRIAL_MAX_PROJECTS=1
ARKLOG_ADMIN_EMAILS=

# Platform vault. Generate two independent random values with at least 32 characters.
# These do not grant access to external services. They encrypt user-owned tokens and
# sign the temporary provider return state.
CONNECTIONS_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=
OAUTH_STATE_TTL_SECONDS=600

# GitHub App owned by ArkLog.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SETUP_URI=http://localhost:8000/api/v1/connections/github/setup
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/connections/github/callback
GITHUB_API_VERSION=2022-11-28

# Slack OAuth application. Request bot scopes:
# channels:read, groups:read, channels:history, groups:history, chat:write
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/api/v1/connections/slack/callback

# Notion public connection with read, insert and update content capabilities.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8000/api/v1/connections/notion/callback
NOTION_API_VERSION=2026-03-11

# ClickUp OAuth application.
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_REDIRECT_URI=http://localhost:8000/api/v1/connections/clickup/callback

# Trello Power-Up/API key. User tokens are encrypted per connection.
TRELLO_API_KEY=
TRELLO_REDIRECT_URI=http://localhost:5173/trello/callback

# Optional signature for legacy GitHub webhooks. It is not a repository access token.
GITHUB_WEBHOOK_SECRET=

# OpenRouter platform service. Never expose this through VITE_ or browser code.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=google/gemini-2.5-flash
AI_TRIAL_MODEL=google/gemini-2.5-flash
AI_MAX_TOKENS=2000
AI_MAX_TOKENS_BACKFILL=8000
AI_TRIAL_MAX_TOKENS=1200
AI_MAX_PROMPT_CHARS=120000
AI_TRIAL_MAX_PROMPT_CHARS=30000
AI_TEMPERATURE=0.3

# Persistent production database. SQLite is rejected in cloud/production.
DATABASE_URL=sqlite+aiosqlite:///./data/arklog.db

# Disabled on serverless replicas. Scheduling will use one external scheduler/queue.
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=America/Sao_Paulo
MAX_COMMITS_PER_WEBHOOK=50
