# ArkLog secure deployment
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# Shared Ark account. This endpoint validates the bearer token.
ARK_AUTH_ME_URL=https://www.arksystem.net/api/saas?action=me
ARK_AUTH_TIMEOUT_SECONDS=8
ARKLOG_AUTO_TRIAL=false
ARKLOG_TRIAL_REPORT_LIMIT=1
ARKLOG_ACTIVE_REPORT_LIMIT=50
ARKLOG_TRIAL_MAX_WINDOW_HOURS=168
ARKLOG_TRIAL_MAX_PROJECTS=1
# Optional fallback. Platform administrators from the Ark account are auto-admins.
ARKLOG_ADMIN_EMAILS=

# GitHub owner credentials are used only by ArkLog administrators.
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# OpenRouter. Never expose this variable through VITE_ or browser code.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=google/gemini-2.5-flash
AI_TRIAL_MODEL=google/gemini-2.5-flash
AI_MAX_TOKENS=2000
AI_MAX_TOKENS_BACKFILL=8000
AI_TRIAL_MAX_TOKENS=1200
AI_MAX_PROMPT_CHARS=120000
AI_TRIAL_MAX_PROMPT_CHARS=30000
AI_TEMPERATURE=0.3

# Persistent production database. SQLite is rejected when APP_ENV=production.
DATABASE_URL=sqlite+aiosqlite:///./data/arklog.db

# Owner-only external publisher.
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=

# Disabled by default, especially on serverless deployments.
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=America/Sao_Paulo
MAX_COMMITS_PER_WEBHOOK=50
