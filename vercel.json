{
  "version": 2,
  "regions": ["gru1"],
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" },
    { "src": "dashboard/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "src": "/api/arklog/v1/(.*)", "dest": "/api/index.py" },
    { "src": "/api/v1/(.*)", "dest": "/api/index.py" },
    { "src": "/arklog/assets/(.*)", "dest": "/dashboard/assets/$1" },
    { "src": "/arklog/(.*\\.(?:png|jpg|jpeg|svg|ico|webp))", "dest": "/dashboard/$1" },
    { "src": "/arklog(?:/.*)?", "dest": "/dashboard/index.html" },
    { "src": "/", "status": 302, "headers": { "Location": "/arklog" } }
  ]
}
